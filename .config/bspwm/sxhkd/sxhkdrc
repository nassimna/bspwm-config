#################################################################
# sxhkd: Refactored Configuration for a Developer Workflow
#################################################################

#----------------------------------------------------------------
# CORE BSPWM & SYSTEM
#----------------------------------------------------------------

# Reload bspwm configuration
super + shift + r
    bspc wm -r

# Reload sxhkd configuration
super + Escape
    pkill -USR1 -x sxhkd

# Quit bspwm
super + alt + q
    bspc quit

# Logout / power menu
super + shift + e
    ~/.config/bspwm/scripts/powermenu

# Kill a window process
super + shift + q
    bspc node -k

# Close a window
super + q
    bspc node -c

# Xkill (for unresponsive applications)
super + shift + Escape
    xkill

#----------------------------------------------------------------
# LAUNCHERS (UNIFIED ON ROFI)
#----------------------------------------------------------------

# Rofi: Application Launcher (drun mode)
super + d
    rofi -show drun -show-icons -theme ~/.config/rofi/launcher.rasi

# Rofi: Window Switcher
super + Tab
    rofi -show window -show-icons -theme ~/.config/rofi/window.rasi

# Rofi: Run Command
super + shift + d
    rofi -show run -theme ~/.config/rofi/run.rasi

# Rofi: Combi Mode (Apps + Windows)
super + F1
    rofi -show combi -show-icons -theme ~/.config/rofi/theme.rasi

#----------------------------------------------------------------
# PRIMARY APPLICATIONS
#----------------------------------------------------------------

# Terminal Emulator
super + Return
    alacritty

# File Manager (Thunar)
super + t
    sh -c 'if command -v thunar >/dev/null 2>&1; then thunar; elif command -v nautilus >/dev/null 2>&1; then nautilus; else xdg-open "$HOME"; fi'

# Web Browser 
super + w
    sh -c 'for browser in google-chrome-stable google-chrome chromium microsoft-edge-stable firefox; do if command -v "$browser" >/dev/null 2>&1; then exec "$browser"; fi; done; xdg-open about:blank'

# Code Editor
super + e
    sh -c 'for editor in code-insiders code codium; do if command -v "$editor" >/dev/null 2>&1; then exec "$editor"; fi; done'
# Discord
super + s
    sh -c 'for app in discord Discord vesktop webcord; do if command -v "$app" >/dev/null 2>&1; then exec "$app"; fi; done'
#----------------------------------------------------------------
# WORKSPACE / DESKTOP MANAGEMENT
#----------------------------------------------------------------

# Focus primary desktops
super + {1-5}
    bspc desktop -f '^{1-5}'

# Focus secondary desktops when a second screen is plugged in
ctrl + {1-5}
    bspc desktop -f '^{6,7,8,9,10}'

# Send focused window to primary desktops
super + shift + {1-5}
    bspc node -d '^{1-5}' --follow

# Send focused window to secondary desktops when available
ctrl + shift + {1-5}
    bspc node -d '^{6,7,8,9,10}' --follow
#----------------------------------------------------------------
# WINDOW STATE & LAYOUT MANAGEMENT
#----------------------------------------------------------------

# Set window state (tiled, pseudo_tiled, floating, fullscreen)
super + space
    bspc node -t \~
# Set window state (floating )
super + f
    bspc node -t \~floating

# Toggle fullscreen state
alt + Return
    bspc node -t \~fullscreen

# bsp-layout: monocle/mono layout
super + m
    ~/.config/bspwm/scripts/toggle-layout mono

# bsp-layout: toggle grid and default tiled layout
super + g
    ~/.config/bspwm/scripts/toggle-layout grid

# Focus next/previous window on the current desktop
alt + Tab
    bspc node -f next.local.window

alt + shift + Tab
    bspc node -f prev.local.window

# Focus window by direction (vim-like keys)
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Swap window by direction (vim-like keys)
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Swap window by direction (arrow keys)
super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}

# Preselect split direction for next window
super + ctrl + {h,j,k,l}
    bspc node -p {west,south,north,east}

# Preselect split ratio
super + ctrl + {1-9}
    bspc node -o 0.{1-9}

# Cancel preselection
super + ctrl + space
    bspc node -p cancel

# Rotate layout
alt + space
    bspc node @/ --rotate 90

# Flip layout     
alt + shift + space
    bspc node @/ --flip horizontal

# Balance the window tree
super + b
    bspc node @/ --balance

# Send window to the other monitor and stay focused on it
super + shift + m
    bspc node -m next --follow

# Move floating windows
super + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# Grow windows
super + alt + {h,j,k,l}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

super + alt + {Left,Down,Up,Right}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Shrink windows
ctrl + alt + {h,j,k,l}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

ctrl + alt + {Left,Down,Up,Right}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

#----------------------------------------------------------------
# MULTIMEDIA & UTILITIES
#----------------------------------------------------------------

# Volume control
XF86Audio{RaiseVolume,LowerVolume,Mute}
    sh -c 'if command -v wpctl >/dev/null 2>&1; then wpctl {set-volume @DEFAULT_AUDIO_SINK@ 5%+,set-volume @DEFAULT_AUDIO_SINK@ 5%-,set-mute @DEFAULT_AUDIO_SINK@ toggle}; elif command -v pactl >/dev/null 2>&1; then pactl {set-sink-volume @DEFAULT_SINK@ +5%,set-sink-volume @DEFAULT_SINK@ -5%,set-sink-mute @DEFAULT_SINK@ toggle}; else amixer set Master {5%+,5%-,toggle}; fi'

# Player control
XF86Audio{Play,Next,Prev,Stop}
    playerctl {play-pause,next,previous,stop}

# Brightness control
XF86MonBrightness{Up,Down}
    sh -c 'if command -v brightnessctl >/dev/null 2>&1; then brightnessctl set {+10%,10%-}; else xbacklight -{inc,dec} 10; fi'

# Screenshot (full screen)
Print
    /home/nassim/.config/hypr/scripts/screenshot full
# Screenshot selection to clipboard directly
shift + Print
    /home/nassim/.config/hypr/scripts/screenshot area
# Toggle Polybar
super + y
    polybar-msg cmd toggle

# Toggle Obsidian Todo Widget (Conky)
super + n
    ~/.config/polybar/scripts/obsidian-todos-widget.sh toggle

# Toggle Language between en and ar
alt + shift + l
    setxkbmap -layout us,ara -option grp:alt_shift_toggle
